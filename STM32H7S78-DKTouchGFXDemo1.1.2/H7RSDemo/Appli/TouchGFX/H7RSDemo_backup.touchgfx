        "Interactions": [
          {
            "InteractionName": "ExpandTheMenu",
            "Trigger": {
              "Type": "TriggerClicked",
              "TriggerComponent": "menuClickListener"
            },
            "Action": {
              "Type": "ActionCustom2",
              "ActionCustomTypeName": "Call WaffleMenuContainer changeStateOfMenuTo",
              "ParameterValue": "SlideMenu::EXPANDED",
              "ActionComponent": "WaffleMenuContainer"
            }
          },
          {
            "InteractionName": "BigWaffleIsChosen",
            "Trigger": {
              "Type": "TriggerCustom",
              "TriggerCustomTypeName": "WaffleMenuIcon IconIsPressed happens",
              "TriggerComponent": "bigWaffleMenuIcon"
            },
            "Action": {
              "Type": "ActionCustom",
              "FunctionName": "bigWaffleIsChosen"
            }
          },
          {
            "InteractionName": "MediumWaffleIsChosen",
            "Trigger": {
              "Type": "TriggerCustom",
              "TriggerCustomTypeName": "WaffleMenuIcon IconIsPressed happens",
              "TriggerComponent": "mediumWaffleMenuIcon"
            },
            "Action": {
              "Type": "ActionCustom",
              "FunctionName": "mediumWaffleIsChosen"
            }
          },
          {
            "InteractionName": "SmallWaffleIsChosen",
            "Trigger": {
              "Type": "TriggerCustom",
              "TriggerCustomTypeName": "WaffleMenuIcon IconIsPressed happens",
              "TriggerComponent": "smallWaffleMenuIcon"
            },
            "Action": {
              "Type": "ActionCustom",
              "FunctionName": "smallWaffleIsChosen"
            }
          },
          {
            "InteractionName": "ChangeWaffleLabelAndClickListenerWhenStateOfMenuChanges",
            "Trigger": {
              "Type": "TriggerSlideMenuAnimationEnded",
              "TriggerComponent": "slideMenu"
            },
            "Action": {
              "Type": "ActionCustom",
              "FunctionName": "reactAccordinglyToTheNewStateOfMenu"
            }
          }
        ],
        "CustomTriggers": [
          {
            "Name": "newWaffleIsChosen"
          },
          {
            "Name": "slideMenuChangedState"
          }
        ],
        "CustomActions": [
          {
            "Name": "changeStateOfMenuTo",
            "HasValue": true,
            "ValueType": "SlideMenu::State"
          }
        ]
