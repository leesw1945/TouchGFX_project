{
  "Application": {
    "Screens": [
      {
        "Name": "Screen1",
        "Includes": "#include <stdlib.h>",
        "Components": [
          {
            "Type": "Box",
            "Name": "background",
            "Width": 480,
            "Height": 272,
            "Color": {
              "Red": 255,
              "Green": 255,
              "Blue": 255
            }
          },
          {
            "Type": "CustomContainerInstance",
            "Name": "colorEmitter1",
            "X": 107,
            "Y": 11,
            "Width": 250,
            "Height": 250,
            "CustomContainerDefinitionName": "ColorEmitter"
          }
        ],
        "Interactions": [
          {
            "InteractionName": "Interaction1",
            "Trigger": {
              "Type": "TriggerWhen",
              "ActionCustomTypeName": "Call Screen1 setBackgroundColor"
            },
            "Action": {
              "Type": "ActionExecuteCode",
              "Code": "background.setColor(value);\r\nbackground.invalidate();"
            }
          },
          {
            "InteractionName": "Interaction2",
            "Trigger": {
              "Type": "TriggerCustom",
              "TriggerCustomTypeName": "ColorEmitter colorChanged happens",
              "TriggerComponent": "colorEmitter1"
            },
            "Action": {
              "Type": "ActionCustom2",
              "ActionCustomTypeName": "Call Screen1 setBackgroundColor",
              "ParameterValue": "value",
              "ActionComponent": "Screen1"
            }
          }
        ],
        "CustomActions": [
          {
            "Name": "setBackgroundColor",
            "Description": "Sets the background color",
            "HasValue": true,
            "ValueType": "colortype"
          }
        ]
      }
    ],
    "CustomContainerDefinitions": [
      {
        "Name": "ColorEmitter",
        "Width": 250,
        "Height": 250,
        "Includes": "#include <touchgfx/Color.hpp>",
        "Components": [
          {
            "Type": "Button",
            "Name": "button",
            "Width": 240,
            "Height": 50,
            "Pressed": "__generated\\alternate_theme_images_widgets_button_regular_height_50_medium_rounded_pressed.png",
            "Released": "__generated\\alternate_theme_images_widgets_button_regular_height_50_medium_rounded_normal.png",
            "Preset": "alternate_theme\\presets\\button\\regular\\height_50\\medium_rounded_normal.json"
          }
        ],
        "Interactions": [
          {
            "InteractionName": "Interaction1",
            "Trigger": {
              "Type": "TriggerClicked",
              "TriggerComponent": "button"
            },
            "Action": {
              "Type": "ActionEmit",
              "TriggerCustomTypeName": "ColorEmitter colorChanged happens",
              "ParameterValue": "touchgfx::Color::getColorFromRGB(rand()%256, rand()%256, rand()%256)"
            }
          }
        ],
        "CustomTriggers": [
          {
            "Name": "colorChanged",
            "Description": "The color has changed",
            "HasValue": true,
            "ValueType": "colortype"
          }
        ]
      }
    ],
    "Name": "CustomTriggerAction",
    "Resolution": {
      "Width": 480,
      "Height": 272
    },
    "SelectedColorDepth": 24,
    "StartupScreenName": "Screen1",
    "SelectedStartupLanguage": "GB",
    "TouchGfxPath": "touchgfx",
    "UIPath": ".",
    "ApplicationTemplateName": "Simulator",
    "ApplicationTemplateVersion": "2.0.0",
    "ApplicationTemplateDescription": "Simulator Application Template",
    "AvailableColorDepths": [
      1,
      2,
      4,
      8,
      16,
      24
    ],
    "AvailableLCDs": {
      "1": "LCD1bpp",
      "2": "LCD2bpp",
      "4": "LCD4bpp",
      "8": "LCD8bpp_ARGB2222",
      "16": "LCD16bpp",
      "24": "LCD24bpp"
    },
    "AvailableSections": [
      "ExtFlashSection",
      "IntFlashSection"
    ],
    "AvailableResolutions": [],
    "PhysicalButtons": [],
    "FrameworkFeatures": {
      "LCD24bpp": {
        "Id": "LCD24bpp",
        "IsEnabled": true
      }
    },
    "GenerateAssetsCommand": "make -f simulator/gcc/Makefile assets -j8",
    "PostGenerateCommand": "touchgfx update_project --project-file=simulator/msvs/Application.vcxproj",
    "CompileSimulatorCommand": "make -f simulator/gcc/Makefile -j8",
    "RunSimulatorCommand": "build\\bin\\simulator.exe",
    "CompileTargetCommand": "",
    "FlashTargetCommand": "",
    "LandscapeSkinX": 0,
    "LandscapeSkinY": 0,
    "PortraitSkinX": 0,
    "PortraitSkinY": 0,
    "DisplayOrientation": "Landscape",
    "AdditionalFeatures": [
      "VectorFonts"
    ]
  },
  "Version": "4.25.0",
  "CreatedBy": "4.25.0"
}